# ==========================================
# WindForecast Analytics Configuration
# ==========================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# Elexon API Configuration
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_REQUEST_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3

# Market Cutoff Configuration
DEFAULT_CUTOFF_HOUR_UTC=11
DEFAULT_TARGET_YEAR=2026
DEFAULT_TARGET_MONTH=1

# Cache Configuration
CACHE_DIR=data/cache
ENABLE_CACHE=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
